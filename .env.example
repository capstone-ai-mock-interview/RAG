# LiveKit Cloud URL. 값은 팀 공유 문서 참고.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── AWS (Bedrock + Knowledge Base) ───────────────────────
# EC2 IAM Role 사용 시 아래 KEY 는 주석 유지.
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# ── LLM Provider 선택 ────────────────────────────────────
# bedrock : 실제 AWS Bedrock 호출 (AWS 자격증명 필요)
# mock    : AWS 없이 로컬 테스트, 준비된 샘플 질문만 반환
LLM_PROVIDER=bedrock

# ── Bedrock LLM 모델 ─────────────────────────────────────
# 질문 생성 기본 모델
LLM_MODEL=us.anthropic.claude-sonnet-4-6
# 답변 요약 모델
SUMMARY_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# 답변 판단 모델. 비워두면 LLM_MODEL 값을 사용.
# JUDGE_MODEL=us.anthropic.claude-sonnet-4-6

# ── Bedrock Knowledge Base ───────────────────────────────
# 비워두면 RAG retrieve 를 skip (Claude 단독 호출).
KNOWLEDGE_BASE_ID=MVJMHC0YM2
KB_TOP_K=4

# ── 크롤링 저장소 ──────────────────────────────────────────
# KB 데이터 소스의 S3 URI와 같은 bucket/prefix를 사용해야 합니다.
# 현재 KB 데이터 소스: s3://pj-kmucd1-10-bk/pj-kmucd1-10-KBbk/
S3_BUCKET_NAME=pj-kmucd1-10-bk
S3_PREFIX=pj-kmucd1-10-KBbk/

# ── 로깅 ─────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Backend 내부 API (QnA 저장용) ────────────────────────
BACKEND_INTERNAL_URL=
SERVICE_TOKEN=

# ── 검색 API (pipeline/data_audit) ───────────────────────
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret
NAVER_SEARCH_TARGETS=blog,webkr

# Google Custom Search API (무료 100건/일)
# 1) Google Cloud Console -> Custom Search API 활성화
# 2) https://programmablesearchengine.google.com -> 검색 엔진 생성 -> ID 복사
GOOGLE_API_KEY=your_google_api_key
GOOGLE_CSE_ID=your_custom_search_engine_id
